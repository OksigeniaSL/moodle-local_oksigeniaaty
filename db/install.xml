<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/oksigeniaaty/db" VERSION="20261114" COMMENT="XMLDB file for Moodle local/oksigeniaaty"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_oksigeniaaty_pin" COMMENT="Per-user app sign-in PIN (hashed) with brute-force throttling.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The user the PIN belongs to."/>
        <FIELD NAME="pinhash" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="The hashed PIN (never the PIN itself)."/>
        <FIELD NAME="fails" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Consecutive wrong tries."/>
        <FIELD NAME="lockuntil" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Unix time until which verification is locked."/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign-unique" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_oksigeniaaty_h5pdl" COMMENT="H5P content and activities whose download this plugin turned on, to turn it off again if the site turns the setting off.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="tablename" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="h5p or h5pactivity."/>
        <FIELD NAME="itemid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The id in that table."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="tableitem" UNIQUE="true" FIELDS="tablename, itemid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
