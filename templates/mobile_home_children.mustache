{{!
    @template local_oksigeniaaty/mobile_home_children

    The children of an adult of a family, on the app's home (design by Jujol, 15 November 2026): a card for each, with
    their initial, name and group, and a line for each thing that has something today; and the way to add another.

    Context variables required for this template:
    * childrenheading, familyheading, familyaddname - The words.
    * children - id, label, initial, group, argsjson, hasfacets and facets (text, icon, urgent, hasmenu, menu, menucolor).
    * haschildren - Whether there are children yet.

    Example context (json):
    {
        "childrenheading": "Sus hijos", "familyheading": "Tu familia", "familyaddname": "Añadir otro hijo",
        "haschildren": true,
        "children": [{"label": "Leo", "initial": "L", "group": "3.º B", "argsjson": "{}", "hasfacets": true,
            "facets": [{"text": "Ha comido todo", "icon": "fas-utensils", "urgent": false, "hasmenu": true, "menu": "A",
                "menucolor": "#2563a8"}]}]
    }
}}
{{#hasfamily}}
    <h2 class="aty-section">{{childrenheading}}</h2>
    <div class="aty-hijos-tarjetas">
        {{#children}}
        <div class="aty-hijo-tarjeta" role="button" tabindex="0" core-site-plugins-new-content component="local_oksigeniaaty" method="mobile_child" title="{{label}}" [args]="{{argsjson}}">
            <span class="aty-hijo-foto" aria-hidden="true">{{initial}}</span>
            <span class="aty-hijo-quien"><span class="aty-hijo-nombre">{{label}}</span>{{#group}}<span class="aty-hijo-grupo">{{group}}</span>{{/group}}</span>
            <ion-icon class="aty-hijo-flecha" name="fas-chevron-right" aria-hidden="true"></ion-icon>
            {{#hasfacets}}
            <ul class="aty-facetas">
                {{#facets}}
                <li class="aty-faceta{{#urgent}} aty-faceta-urgente{{/urgent}}">
                    <span class="aty-faceta-icono"><ion-icon name="{{icon}}" aria-hidden="true"></ion-icon></span>
                    <span>{{#hasmenu}}<span class="aty-faceta-menu"{{#menucolor}} style="--aty-faceta-color: {{menucolor}}"{{/menucolor}}>{{menu}}</span>{{/hasmenu}}{{#urgent}}<b>{{text}}</b>{{/urgent}}{{^urgent}}{{text}}{{/urgent}}</span>
                </li>
                {{/facets}}
            </ul>
            {{/hasfacets}}
        </div>
        {{/children}}
    </div>
    <div class="aty-hijos" role="group" aria-label="{{familyheading}}">
        {{#haschildren}}
        <button type="button" class="aty-hijo aty-hijo-mas aty-hijo-solo" core-site-plugins-new-content component="local_oksigeniaaty" method="mobile_family_add" title="{{familyaddname}}" aria-label="{{familyaddname}}">
            <ion-icon name="fas-plus" aria-hidden="true"></ion-icon>
        </button>
        {{/haschildren}}
        {{^haschildren}}
        <button type="button" class="aty-hijo aty-hijo-mas" core-site-plugins-new-content component="local_oksigeniaaty" method="mobile_family_add" title="{{familyaddname}}">
            <ion-icon name="fas-plus" aria-hidden="true"></ion-icon>{{familyaddname}}
        </button>
        {{/haschildren}}
    </div>
{{/hasfamily}}
