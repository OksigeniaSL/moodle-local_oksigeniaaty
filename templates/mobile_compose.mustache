{{!
    @template local_oksigeniaaty/mobile_compose

    "Write to a course", in the app: a course, a title and a few words, which go to its announcements.

    Context variables required for this template:
    * hasclasses, classes - Where the person may write: forumid, name.
    * intro, courselabel, subjectlabel, messagelabel, publish, confirm, sent, empty - The words of the page.

    Example context (json):
    {
        "hasclasses": true,
        "classes": [{"forumid": 3, "name": "Inglés B2"}],
        "intro": "It goes to the course's announcements and reaches everyone in it.",
        "courselabel": "Course",
        "subjectlabel": "Title",
        "messagelabel": "Message",
        "publish": "Publish",
        "confirm": "Publish this?",
        "sent": "Published.",
        "empty": "You cannot write to any course."
    }
}}
<div class="ion-padding">
    {{#hasclasses}}
    <p>{{intro}}</p>
    <ion-list>
        <ion-item>
            <ion-select label="{{courselabel}}" labelPlacement="stacked" interface="action-sheet" [(ngModel)]="CONTENT_OTHERDATA.forumid">
                {{#classes}}
                <ion-select-option value="{{forumid}}">{{name}}</ion-select-option>
                {{/classes}}
            </ion-select>
        </ion-item>
        <ion-item>
            <ion-input label="{{subjectlabel}}" labelPlacement="stacked" maxlength="255" [(ngModel)]="CONTENT_OTHERDATA.subject"></ion-input>
        </ion-item>
        <ion-item>
            <ion-textarea label="{{messagelabel}}" labelPlacement="stacked" rows="6" [(ngModel)]="CONTENT_OTHERDATA.message"></ion-textarea>
        </ion-item>
    </ion-list>
    <ion-button expand="block" class="ion-margin-top" core-site-plugins-call-ws name="local_oksigeniaaty_post_to_class"
        [params]="{forumid: CONTENT_OTHERDATA.forumid, subject: CONTENT_OTHERDATA.subject, message: CONTENT_OTHERDATA.message}"
        [preSets]="{getFromCache: 0, saveToCache: 0}"
        confirmMessage="{{confirm}}" successMessage="{{sent}}" goBackOnSuccess="true"
        [disabled]="!CONTENT_OTHERDATA.forumid || !CONTENT_OTHERDATA.subject || !CONTENT_OTHERDATA.message">
        {{publish}}
    </ion-button>
    {{/hasclasses}}
    {{^hasclasses}}
    <p>{{empty}}</p>
    {{/hasclasses}}
</div>
