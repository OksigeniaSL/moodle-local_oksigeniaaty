{{!
    @template local_oksigeniaaty/mobile_home

    The per-site home tab shown in the app: a brand hero and the shortcuts in a two-column mosaic.
    Design: the common per-client template (agents/arte/docs/aty-app-plantilla.md).

    Classes required for JS:
    * none

    Context variables required for this template:
    * logourl - A white logo shown over the brand hero (may be empty).
    * pictureurl - A photo or an illustration that fills the hero (may be empty).
    * greeting - A personal greeting with the user's first name (may be empty).
    * heading - The site heading shown in the hero.
    * intro - A short welcome under the heading (may be empty).
    * todayheading, hastoday, today - What is left of today, like the events below.
    * hasunread, unread, unreadlabel, messagesname, messagesurl - The unread conversations, among today's things.
    * eventsheading - The label above the upcoming events.
    * hasevents - Whether there is at least one upcoming event.
    * events - A list of { name, day, month, time, context, viewurl }.
    * shortcutsheading - The label above the shortcuts.
    * hasshortcuts - Whether there is at least one shortcut.
    * shortcuts - A list of { label, url, icon, external }.
    * coursesheading - The label above the course cards.
    * hascourses - Whether there is at least one course to show.
    * courses - A list of { name, initial, hue, viewurl }.
    * opensoutside - Accessible label for the "opens outside the app" marker.
    * gradingheading, grading, hasgrading - For teachers: the assignments waiting for a grade (name, context, count,
      countlabel, viewurl).
    * cards - Sections other plugins add for this user: { heading, items }. An item has title, detail, urgent, its chip
      (hasdate, timestamp, day, month; or hascount, count, countlabel) and where it opens (ispage, component, method,
      pagetitle, argsjson; or url). Their tiles come among the shortcuts, with the same fields for where they open.

    Example context (json):
    {
        "logourl": "",
        "heading": "Centro Ejemplo",
        "intro": "Bienvenido a tu plataforma de formación.",
        "shortcutsheading": "Accesos",
        "hasshortcuts": true,
        "shortcuts": [
            { "label": "Matrícula", "url": "https://ejemplo.oksigenia.com/matricula", "icon": "fas-calendar", "external": true }
        ],
        "opensoutside": "Opens outside the app"
    }
}}
<div class="aty-home">
    {{#greeting}}<p class="aty-greeting">{{greeting}}</p>{{/greeting}}
    <section class="aty-hero{{#pictureurl}} aty-hero-pictured{{/pictureurl}}">
        {{#pictureurl}}<img class="aty-hero-picture" src="{{pictureurl}}" alt="">{{/pictureurl}}
        {{#logourl}}<img class="aty-hero-logo" src="{{logourl}}" alt="">{{/logourl}}
        <h1 class="aty-hero-title">{{heading}}</h1>
        {{#intro}}<p class="aty-hero-intro">{{intro}}</p>{{/intro}}
    </section>
    {{#hastoday}}
    <h2 class="aty-section">{{todayheading}}</h2>
    <div class="aty-agenda">
        {{#hasunread}}
        <a class="aty-event aty-grading" core-link href="{{messagesurl}}" capture="true">
            <span class="aty-event-date">
                <span class="aty-event-day">{{unread}}</span>
                <span class="aty-event-month">{{unreadlabel}}</span>
            </span>
            <span class="aty-event-body">
                <span class="aty-event-name">{{messagesname}}</span>
            </span>
        </a>
        {{/hasunread}}
        {{#today}}
        <a class="aty-event" core-link href="{{viewurl}}" capture="true">
            <span class="aty-event-date">
                <span class="aty-event-day" [textContent]="{{timestamp}} | coreFormatDate:'%e'">{{day}}</span>
                <span class="aty-event-month" [textContent]="({{timestamp}} | coreFormatDate:'%b').replace('.', '')">{{month}}</span>
            </span>
            <span class="aty-event-body">
                <span class="aty-event-name">{{name}}</span>
                {{#context}}<span class="aty-event-context">{{context}}</span>{{/context}}
            </span>
            {{#time}}<span class="aty-event-time" [textContent]="{{timestamp}} | coreFormatDate:'strftimetime'">{{time}}</span>{{/time}}
        </a>
        {{/today}}
    </div>
    {{/hastoday}}
    {{#hasgrading}}
    <h2 class="aty-section">{{gradingheading}}</h2>
    <div class="aty-agenda">
        {{#grading}}
        <a class="aty-event aty-grading" core-link href="{{viewurl}}" capture="true">
            <span class="aty-event-date">
                <span class="aty-event-day">{{count}}</span>
                <span class="aty-event-month">{{countlabel}}</span>
            </span>
            <span class="aty-event-body">
                <span class="aty-event-name">{{name}}</span>
                <span class="aty-event-context">{{context}}</span>
            </span>
        </a>
        {{/grading}}
    </div>
    {{/hasgrading}}
    {{#cards}}
    <h2 class="aty-section">{{heading}}</h2>
    <div class="aty-agenda">
        {{#items}}
        {{#ispage}}<button type="button" class="aty-event{{#hascount}} aty-grading{{/hascount}}{{#urgent}} aty-urgent{{/urgent}}" core-site-plugins-new-content component="{{component}}" method="{{method}}" title="{{pagetitle}}" [args]="{{argsjson}}">{{/ispage}}
        {{^ispage}}<a class="aty-event{{#hascount}} aty-grading{{/hascount}}{{#urgent}} aty-urgent{{/urgent}}" core-link href="{{url}}" capture="true">{{/ispage}}
            {{#hasdate}}
            <span class="aty-event-date">
                <span class="aty-event-day" [textContent]="{{timestamp}} | coreFormatDate:'%e'">{{day}}</span>
                <span class="aty-event-month" [textContent]="({{timestamp}} | coreFormatDate:'%b').replace('.', '')">{{month}}</span>
            </span>
            {{/hasdate}}
            {{#hascount}}
            <span class="aty-event-date">
                <span class="aty-event-day">{{count}}</span>
                <span class="aty-event-month">{{countlabel}}</span>
            </span>
            {{/hascount}}
            <span class="aty-event-body">
                <span class="aty-event-name">{{title}}</span>
                {{#detail}}<span class="aty-event-context">{{detail}}</span>{{/detail}}
            </span>
        {{#ispage}}</button>{{/ispage}}
        {{^ispage}}</a>{{/ispage}}
        {{/items}}
    </div>
    {{/cards}}
    {{#hasevents}}
    <h2 class="aty-section">{{eventsheading}}</h2>
    <div class="aty-agenda">
        {{#events}}
        <a class="aty-event" core-link href="{{viewurl}}" capture="true">
            <span class="aty-event-date">
                <span class="aty-event-day" [textContent]="{{timestamp}} | coreFormatDate:'%e'">{{day}}</span>
                <span class="aty-event-month" [textContent]="({{timestamp}} | coreFormatDate:'%b').replace('.', '')">{{month}}</span>
            </span>
            <span class="aty-event-body">
                <span class="aty-event-name">{{name}}</span>
                {{#context}}<span class="aty-event-context">{{context}}</span>{{/context}}
            </span>
            {{#time}}<span class="aty-event-time" [textContent]="{{timestamp}} | coreFormatDate:'strftimetime'">{{time}}</span>{{/time}}
        </a>
        {{/events}}
    </div>
    {{/hasevents}}
    {{#hasshortcuts}}
    <h2 class="aty-section">{{shortcutsheading}}</h2>
    <ion-grid class="aty-tiles"><ion-row>
        {{#shortcuts}}
        <ion-col size="6">
            {{#ispage}}<ion-card class="aty-tile" button="true" core-site-plugins-new-content component="{{component}}" method="{{method}}" title="{{pagetitle}}" [args]="{{argsjson}}">{{/ispage}}
            {{^ispage}}<ion-card class="aty-tile" button="true" core-link href="{{url}}" capture="{{^external}}true{{/external}}{{#external}}false{{/external}}">{{/ispage}}
                <span class="aty-tile-icon"><ion-icon name="{{icon}}" aria-hidden="true"></ion-icon></span>
                <span class="aty-tile-label">{{label}}</span>
                {{#external}}<ion-icon class="aty-tile-out" name="fas-arrow-up-right-from-square" aria-label="{{opensoutside}}"></ion-icon>{{/external}}
            </ion-card>
        </ion-col>
        {{/shortcuts}}
    </ion-row></ion-grid>
    {{/hasshortcuts}}
    {{#hascourses}}
    <h2 class="aty-section">{{coursesheading}}</h2>
    <ion-grid class="aty-tiles"><ion-row>
        {{#courses}}
        <ion-col size="6">
            <a class="aty-course-card" core-link href="{{viewurl}}" capture="true" style="--aty-hue: {{hue}}deg">
                <span class="aty-course-initial" aria-hidden="true">{{initial}}</span>
                <span class="aty-course-name">{{name}}</span>
            </a>
        </ion-col>
        {{/courses}}
    </ion-row></ion-grid>
    {{/hascourses}}
</div>
