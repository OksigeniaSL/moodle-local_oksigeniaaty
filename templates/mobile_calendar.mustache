{{!
    @template local_oksigeniaaty/mobile_calendar

    "Your agenda on your phone", in the app's user menu: subscribe the phone's calendar app to the user's Moodle calendar.

    Context variables required for this template:
    * enabled - Whether the site has calendar export turned on.
    * intro - What this does, with the site's name.
    * googleurl - Google Calendar's subscription link to the user's feed.
    * webcalurl - The feed as a webcal link, which other calendar apps open.
    * address - The feed's plain address, for apps that ask for it.

    Example context (json):
    {
        "enabled": true,
        "intro": "Add your Campus agenda to your phone's calendar.",
        "googleurl": "https://calendar.google.com/calendar/r?cid=webcal%3A%2F%2Fexample.com%2Fcalendar%2Fexport_execute.php",
        "webcalurl": "webcal://example.com/calendar/export_execute.php?userid=2&authtoken=abc",
        "address": "https://example.com/calendar/export_execute.php?userid=2&authtoken=abc"
    }
}}
<div class="aty-calendarapp ion-padding">
    {{#enabled}}
    <p class="aty-calendarapp-intro">{{intro}}</p>
    <ion-button expand="block" class="ion-margin-top" core-link href="{{googleurl}}" capture="false">
        <ion-icon name="fab-google" slot="start" aria-hidden="true"></ion-icon>
        {{#str}} calendarapp:google, local_oksigeniaaty {{/str}}
    </ion-button>
    <ion-button expand="block" fill="outline" core-link href="{{webcalurl}}" capture="false">
        <ion-icon name="fas-calendar-plus" slot="start" aria-hidden="true"></ion-icon>
        {{#str}} calendarapp:other, local_oksigeniaaty {{/str}}
    </ion-button>
    <p class="aty-calendarapp-note">{{#str}} calendarapp:address, local_oksigeniaaty {{/str}}</p>
    <p class="aty-calendarapp-address">{{address}}</p>
    <p class="aty-calendarapp-note">{{#str}} calendarapp:private, local_oksigeniaaty {{/str}}</p>
    {{/enabled}}
    {{^enabled}}
    <p class="aty-calendarapp-intro">{{#str}} calendarapp:disabled, local_oksigeniaaty {{/str}}</p>
    {{/enabled}}
</div>
