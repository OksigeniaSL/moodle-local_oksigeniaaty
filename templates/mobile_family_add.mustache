{{!
    @template local_oksigeniaaty/mobile_family_add

    Another child's code, typed in the app.

    Context variables required for this template:
    * intro, codelabel, add, sent - The words of the page.

    Example context (json):
    {
        "intro": "Type the code on the letter from the centre.",
        "codelabel": "Code",
        "add": "Add",
        "sent": "Added."
    }
}}
<div class="ion-padding">
    <p>{{intro}}</p>
    <ion-list>
        <ion-item>
            <ion-input label="{{codelabel}}" labelPlacement="stacked" autocapitalize="characters" [(ngModel)]="CONTENT_OTHERDATA.code"></ion-input>
        </ion-item>
    </ion-list>
    <ion-button expand="block" class="ion-margin-top" core-site-plugins-call-ws name="local_oksigeniaaty_family_claim"
        [params]="{code: CONTENT_OTHERDATA.code}"
        [preSets]="{getFromCache: 0, saveToCache: 0}"
        successMessage="{{sent}}" goBackOnSuccess="true"
        [disabled]="!CONTENT_OTHERDATA.code">
        {{add}}
    </ion-button>
</div>
