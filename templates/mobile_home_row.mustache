{{!
    @template local_oksigeniaaty/mobile_home_row

    A row that another plugin adds to the app's home (local\homecards). The whole row opens its page or its address; a
    row with something to do keeps still and its button opens it instead.

    Classes required for JS:
    * none

    Context variables required for this template:
    * title, detail, urgent - What the row says.
    * hasdate, timestamp, day, month - Its date; hashour and hour - its hour, big in place of the date, for a row of today.
    * kind, kindlabel - A deadline ("Due"), said next to its hour.
    * hascount, count, countlabel - A count in place of the date.
    * actionlabel - The button of a row with something to do ("Sign").
    * ispage, component, method, pagetitle, argsjson - A page of the plugin in the app; or url and browser.

    A row without a title is none: the example, empty, draws nothing, because what the app compiles is not HTML that the
    checks of the templates take.

    Example context (json):
    {}
}}
{{#title}}
{{#actionlabel}}<div class="aty-event{{#urgent}} aty-urgent{{/urgent}}">{{/actionlabel}}
{{^actionlabel}}
{{#ispage}}<button type="button" class="aty-event{{#hascount}} aty-grading{{/hascount}}{{#urgent}} aty-urgent{{/urgent}}" core-site-plugins-new-content component="{{component}}" method="{{method}}" title="{{pagetitle}}" [args]="{{argsjson}}">{{/ispage}}
{{^ispage}}<a class="aty-event{{#hascount}} aty-grading{{/hascount}}{{#urgent}} aty-urgent{{/urgent}}" core-link href="{{url}}" capture="{{^browser}}true{{/browser}}{{#browser}}false{{/browser}}"{{^browser}} inApp="true"{{/browser}}>{{/ispage}}
{{/actionlabel}}
    {{#hashour}}
    <span class="aty-event-hora{{#kind}} aty-hora-plazo{{/kind}}">
        <b [textContent]="{{timestamp}} | coreFormatDate:'strftimetime'">{{hour}}</b>
        {{#kindlabel}}<small>{{kindlabel}}</small>{{/kindlabel}}
    </span>
    {{/hashour}}
    {{^hashour}}
    {{#hasdate}}
    <span class="aty-event-date">
        <span class="aty-event-day" [textContent]="{{timestamp}} | coreFormatDate:'%e'">{{day}}</span>
        <span class="aty-event-month" [textContent]="({{timestamp}} | coreFormatDate:'%b').replace('.', '')">{{month}}</span>
    </span>
    {{/hasdate}}
    {{#hascount}}
    <span class="aty-event-date">
        <span class="aty-event-day">{{count}}</span>
        <span class="aty-event-month">{{countlabel}}</span>
    </span>
    {{/hascount}}
    {{/hashour}}
    <span class="aty-event-body">
        <span class="aty-event-name">{{title}}</span>
        {{#detail}}<span class="aty-event-context">{{detail}}</span>{{/detail}}
    </span>
    {{^hashour}}
    {{#kindlabel}}<span class="aty-plazo"><small>{{kindlabel}}</small><b [textContent]="{{timestamp}} | coreFormatDate:'strftimetime'">{{hour}}</b></span>{{/kindlabel}}
    {{^kindlabel}}{{#hour}}<span class="aty-event-time" [textContent]="{{timestamp}} | coreFormatDate:'strftimetime'">{{hour}}</span>{{/hour}}{{/kindlabel}}
    {{/hashour}}
    {{#actionlabel}}
    {{#ispage}}<button type="button" class="aty-hacer" core-site-plugins-new-content component="{{component}}" method="{{method}}" title="{{pagetitle}}" [args]="{{argsjson}}">{{actionlabel}}</button>{{/ispage}}
    {{^ispage}}<a class="aty-hacer" core-link href="{{url}}" capture="{{^browser}}true{{/browser}}{{#browser}}false{{/browser}}"{{^browser}} inApp="true"{{/browser}}>{{actionlabel}}</a>{{/ispage}}
    {{/actionlabel}}
{{#actionlabel}}</div>{{/actionlabel}}
{{^actionlabel}}{{#ispage}}</button>{{/ispage}}{{^ispage}}</a>{{/ispage}}{{/actionlabel}}
{{/title}}
