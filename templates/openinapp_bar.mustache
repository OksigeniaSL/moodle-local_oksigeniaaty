{{!
    @template local_oksigeniaaty/openinapp_bar

    The slim bar at the foot of a page, on Android phones, that offers to open that same page in the site's app.

    Context variables required for this template:
    * intenturl - Chrome's intent link that opens the page in the app (or its store page).
    * hideurl - The page that hides the bar on this browser for 30 days.

    Example context (json):
    {
        "intenturl": "intent://link=https://example.com/course/view.php?id=2#Intent;scheme=moodlemobile;end",
        "hideurl": "https://example.com/local/oksigeniaaty/bar.php?sesskey=abc&returnurl=/course/view.php?id=2"
    }
}}
<aside class="local-oksigeniaaty-bar" aria-label="{{#str}} openinapp:label, local_oksigeniaaty {{/str}}">
    <span class="local-oksigeniaaty-bar-text">{{#str}} openinapp:text, local_oksigeniaaty {{/str}}</span>
    <a class="btn btn-primary btn-sm" href="{{intenturl}}">{{#str}} openinapp:open, local_oksigeniaaty {{/str}}</a>
    <a class="local-oksigeniaaty-bar-hide" href="{{hideurl}}" title="{{#str}} openinapp:hide, local_oksigeniaaty {{/str}}">
        <span aria-hidden="true">&times;</span>
        <span class="visually-hidden sr-only">{{#str}} openinapp:hide, local_oksigeniaaty {{/str}}</span>
    </a>
</aside>
